# Nova Panel Configuration
PANEL_NAME=Nova
PANEL_PORT=3001
API_PORT=3003
SFTP_PORT=3004
SERVERDB_PORT=3005

# Session Secret
SESSION_SECRET=nova_super_secret_session_change_in_production

# Database Configuration (sqlite or mysql)
DB_TYPE=sqlite
DB_FILE=data/nova.sqlite

# MariaDB / MySQL configuration
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3002
MARIADB_DATABASE=Nova
MARIADB_USER=Nova
MARIADB_PASSWORD=NovaStudio

# Instance Storage Paths
INSTANCE_PATH=Instance/server
ARCHIVE_PATH=Instance/Archive
BACKUP_PATH=Instance/Backup
