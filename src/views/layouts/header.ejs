<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : (panelName || 'Nova') %></title>
  
  <% if (panelFavicon) { %>
    <link rel="icon" href="<%= panelFavicon %>">
  <% } else { %>
    <link rel="icon" href="/arix/Arix.png">
  <% } %>

  <!-- Tailwind CSS CDN with Arix Design Tokens -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            arix: '#4A35CF',
            'arix-hover': '#5F48E8',
            brand: {
              50: '#F5F5FF',
              100: '#EAEBFF',
              400: '#7D6BF2',
              500: '#5E46E5',
              600: '#4A35CF',
              700: '#3925B5'
            },
            gray: {
              50: '#F4F4F4',
              100: '#D5D5DB',
              200: '#B2B2C1',
              300: '#8282A4',
              400: '#5E5E7F',
              500: '#42425B',
              600: '#2B2B40',
              700: '#1D1D37',
              800: '#0B0D2A',
              900: '#040519'
            },
            dark: {
              base: '#040519',
              surface: '#0B0D2A',
              card: '#1D1D37',
              border: '#42425B',
              hover: '#2B2B40'
            }
          },
          borderRadius: {
            box: '10px',
            input: '7px'
          },
          fontFamily: {
            sans: ['"Rubik"', '"Inter"', 'system-ui', 'sans-serif'],
            header: ['"IBM Plex Sans"', '"Inter"', 'sans-serif'],
            mono: ['"Source Code Pro"', '"JetBrains Mono"', 'monospace']
          }
        }
      }
    }
  </script>

  <!-- Lucide & Font Awesome 6 Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  
  <!-- Arix Theme Master Stylesheet -->
  <link rel="stylesheet" href="/css/arix.css">
  <script src="/js/arix.js" defer></script>
</head>
<body class="bg-[#040519] text-[#B2B2C1] min-h-screen flex flex-col antialiased selection:bg-[#4A35CF] selection:text-white">

  <!-- Arix Top Navigation Header -->
  <header class="bg-[#0B0D2A]/90 backdrop-blur-md border-b border-[#42425B] sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      
      <!-- Brand Logo & Name -->
      <div class="flex items-center space-x-3">
        <button id="mobile-menu-toggle" class="lg:hidden text-[#8282A4] hover:text-white focus:outline-none mr-2">
          <i class="fa-solid fa-bars text-xl"></i>
        </button>

        <a href="/dashboard" class="flex items-center space-x-3 group">
          <% if (panelLogo) { %>
            <img src="<%= panelLogo %>" alt="<%= panelName %>" class="h-9 w-auto rounded object-contain">
          <% } else { %>
            <img src="/arix/Arix.png" alt="Arix" class="h-8 w-auto group-hover:scale-105 transition-transform">
          <% } %>
          <div class="flex flex-col">
            <span class="font-bold text-lg text-white tracking-tight flex items-center">
              <%= panelName || 'Nova' %>
              <span class="ml-2 text-[10px] font-semibold px-2 py-0.5 rounded-full bg-[#4A35CF]/20 text-[#7D6BF2] border border-[#4A35CF]/30">Arix v2.1.3</span>
            </span>
          </div>
        </a>
      </div>

      <!-- Center Links (Desktop) -->
      <nav class="hidden md:flex items-center space-x-1">
        <a href="/dashboard" class="px-3.5 py-2 rounded-[7px] text-sm font-medium transition-colors <%= typeof activeSection === 'undefined' && (typeof activeTab === 'undefined' || activeTab === 'dashboard') ? 'bg-[#1D1D37] text-white shadow-sm border border-[#42425B]' : 'text-[#8282A4] hover:text-white hover:bg-[#1D1D37]/50' %>">
          <i class="fa-solid fa-server mr-1.5 text-[#7D6BF2]"></i> Servers
        </a>
        <a href="/account" class="px-3.5 py-2 rounded-[7px] text-sm font-medium transition-colors <%= typeof activeSection === 'undefined' && currentUrl && currentUrl.startsWith('/account') ? 'bg-[#1D1D37] text-white shadow-sm border border-[#42425B]' : 'text-[#8282A4] hover:text-white hover:bg-[#1D1D37]/50' %>">
          <i class="fa-solid fa-circle-user mr-1.5 text-[#8282A4]"></i> Account
        </a>
        <% if (user && user.is_admin) { %>
          <a href="/admin" class="px-3.5 py-2 rounded-[7px] text-sm font-medium transition-all <%= typeof activeSection !== 'undefined' ? 'arix-badge shadow-lg' : 'text-amber-400 hover:text-amber-300 hover:bg-amber-400/10' %>">
            <i class="fa-solid fa-wand-magic-sparkles mr-1.5"></i> Admin Control
          </a>
        <% } %>
      </nav>

      <!-- Right Header Actions -->
      <div class="flex items-center space-x-3">
        <!-- Light / Dark Mode Toggle Button -->
        <button onclick="window.toggleArixTheme()" title="Toggle Theme" class="w-9 h-9 rounded-[7px] bg-[#1D1D37] border border-[#42425B] text-[#8282A4] hover:text-white flex items-center justify-center transition-colors">
          <i class="fa-solid fa-circle-half-stroke text-sm"></i>
        </button>

        <% if (user) { %>
          <!-- User Profile Dropdown -->
          <div class="relative group">
            <button class="flex items-center space-x-3 p-1.5 rounded-[7px] bg-[#1D1D37]/50 hover:bg-[#1D1D37] border border-[#42425B]/50 transition-colors">
              <div class="w-8 h-8 rounded-full bg-[#4A35CF]/20 border border-[#4A35CF]/40 text-[#7D6BF2] flex items-center justify-center font-bold text-sm">
                <%= (user.first_name ? user.first_name[0] : user.username[0]).toUpperCase() %>
              </div>
              <span class="hidden sm:inline-block text-sm font-medium text-[#F4F4F4]">
                <%= user.username %>
              </span>
              <i class="fa-solid fa-chevron-down text-xs text-[#8282A4] group-hover:text-white"></i>
            </button>

            <!-- Dropdown Menu -->
            <div class="absolute right-0 mt-2 w-52 bg-[#1D1D37] border border-[#42425B] rounded-[10px] shadow-2xl py-1 hidden group-hover:block transition-all z-50">
              <div class="px-4 py-2.5 border-b border-[#42425B]">
                <p class="text-xs text-[#8282A4]">Signed in as</p>
                <p class="text-sm font-semibold text-[#F4F4F4] truncate"><%= user.username %></p>
                <% if (user.is_admin) { %>
                  <span class="inline-block mt-1 text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-amber-500/20 text-amber-300 border border-amber-500/30">Administrator</span>
                <% } %>
              </div>
              <a href="/account" class="block px-4 py-2 text-sm text-[#B2B2C1] hover:bg-[#2B2B40] hover:text-white">
                <i class="fa-solid fa-user mr-2 text-[#8282A4]"></i> Profile Settings
              </a>
              <a href="/account/api" class="block px-4 py-2 text-sm text-[#B2B2C1] hover:bg-[#2B2B40] hover:text-white">
                <i class="fa-solid fa-key mr-2 text-[#8282A4]"></i> API Credentials
              </a>
              <a href="/account/ssh-keys" class="block px-4 py-2 text-sm text-[#B2B2C1] hover:bg-[#2B2B40] hover:text-white">
                <i class="fa-solid fa-terminal mr-2 text-[#8282A4]"></i> SSH Keys
              </a>
              <a href="/account/activity" class="block px-4 py-2 text-sm text-[#B2B2C1] hover:bg-[#2B2B40] hover:text-white">
                <i class="fa-solid fa-clock-rotate-left mr-2 text-[#8282A4]"></i> Activity Log
              </a>
              <% if (user.is_admin) { %>
                <div class="border-t border-[#42425B] my-1"></div>
                <a href="/admin" class="block px-4 py-2 text-sm text-[#7D6BF2] hover:bg-[#4A35CF]/15 font-medium">
                  <i class="fa-solid fa-wand-magic-sparkles mr-2"></i> Admin Panel
                </a>
              <% } %>
              <div class="border-t border-[#42425B] my-1"></div>
              <a href="/auth/logout" class="block px-4 py-2 text-sm text-rose-400 hover:bg-rose-500/10">
                <i class="fa-solid fa-right-from-bracket mr-2"></i> Log Out
              </a>
            </div>
          </div>
        <% } else { %>
          <a href="/auth/login" class="arix-btn arix-btn-primary">
            Sign In
          </a>
        <% } %>
      </div>

    </div>
  </header>
