<%- include('../layouts/header') %>

<main class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 flex items-center justify-center">
  <div class="text-center max-w-md arix-card p-8">
    <img src="/arix/images/server_error.svg" alt="500 Server Error" class="w-48 h-48 mx-auto mb-6">
    <h1 class="text-2xl font-bold text-[#F4F4F4] tracking-tight font-header">500 - Server Error</h1>
    <p class="text-sm text-[#8282A4] mt-2 leading-relaxed"><%= message || 'An unexpected exception occurred while processing this request.' %></p>
    <div class="mt-6 flex items-center justify-center space-x-3">
      <a href="/dashboard" class="arix-btn arix-btn-primary">
        <i class="fa-solid fa-house mr-1.5"></i> Back to Dashboard
      </a>
      <button onclick="window.location.reload()" class="arix-btn arix-btn-secondary">
        <i class="fa-solid fa-rotate-right mr-1.5"></i> Retry
      </button>
    </div>
  </div>
</main>

<%- include('../layouts/footer') %>
