<%- include('../layouts/header') %>

<main class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 flex items-center justify-center">
  <div class="text-center max-w-md arix-card p-8">
    <img src="/arix/images/not_found.svg" alt="404 Not Found" class="w-48 h-48 mx-auto mb-6">
    <h1 class="text-2xl font-bold text-[#F4F4F4] tracking-tight font-header">404 - Page Not Found</h1>
    <p class="text-sm text-[#8282A4] mt-2 leading-relaxed"><%= message || 'The requested page or server resource could not be found on this cluster.' %></p>
    <div class="mt-6 flex items-center justify-center space-x-3">
      <a href="/dashboard" class="arix-btn arix-btn-primary">
        <i class="fa-solid fa-house mr-1.5"></i> Back to Dashboard
      </a>
      <a href="javascript:history.back()" class="arix-btn arix-btn-secondary">
        <i class="fa-solid fa-arrow-left mr-1.5"></i> Go Back
      </a>
    </div>
  </div>
</main>

<%- include('../layouts/footer') %>
