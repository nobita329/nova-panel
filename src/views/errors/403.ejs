<%- include('../layouts/header') %>

<main class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 flex items-center justify-center">
  <div class="arix-card p-10 text-center max-w-lg border border-[#42425B] shadow-2xl">
    <img src="/arix/images/not_found.svg" alt="Forbidden" class="h-40 w-auto mx-auto mb-6">
    <span class="arix-badge-danger text-xs font-semibold uppercase px-3 py-1 mb-2">403 - Forbidden</span>
    <h1 class="text-2xl font-bold text-[#F4F4F4] tracking-tight mt-2 font-header">Access Denied</h1>
    <p class="text-sm text-[#8282A4] mt-2"><%= message || 'You do not have permission to access this resource or administrative area.' %></p>
    <div class="mt-8 flex items-center justify-center space-x-3">
      <a href="/dashboard" class="arix-btn arix-btn-primary text-xs py-2 px-5 font-semibold">
        <i class="fa-solid fa-arrow-left mr-1.5"></i> Back to Dashboard
      </a>
    </div>
  </div>
</main>

<%- include('../layouts/footer') %>
