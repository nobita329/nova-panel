<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" href="/arix/Arix.png">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            arix: '#4A35CF',
            'arix-hover': '#5F48E8',
            gray: {
              50: '#F4F4F4', 100: '#D5D5DB', 200: '#B2B2C1', 300: '#8282A4',
              400: '#5E5E7F', 500: '#42425B', 600: '#2B2B40', 700: '#1D1D37',
              800: '#0B0D2A', 900: '#040519'
            }
          },
          fontFamily: {
            sans: ['"Rubik"', '"Inter"', 'system-ui', 'sans-serif'],
            header: ['"IBM Plex Sans"', '"Inter"', 'sans-serif']
          }
        }
      }
    }
  </script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/css/arix.css">
</head>
<body class="bg-[#040519] text-[#B2B2C1] min-h-screen flex items-center justify-center p-4 relative overflow-hidden"
  style="background: linear-gradient(180deg, rgba(4, 5, 25, 0.85) 0%, rgba(11, 13, 42, 0.95) 100%), url('/arix/background-login.png') center/cover no-repeat fixed;">

  <div class="w-full max-w-[440px] relative z-10 my-auto">
    <div class="text-center mb-8">
      <img src="/arix/Arix.png" alt="Arix" class="h-12 mx-auto mb-3 object-contain">
      <h1 class="text-2xl font-bold text-[#F4F4F4] tracking-tight font-header">Reset Password</h1>
      <p class="text-xs text-[#8282A4] mt-1.5">Enter your registered email address to receive password instructions</p>
    </div>

    <div class="bg-[#1D1D37]/80 backdrop-blur-xl border border-[#42425B] rounded-[10px] p-6 sm:p-8 shadow-2xl">
      <% if (message) { %>
        <div class="mb-5 p-3 rounded-[7px] bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 text-xs flex items-center">
          <i class="fa-solid fa-circle-check mr-2 text-base text-emerald-400"></i>
          <span><%= message %></span>
        </div>
      <% } %>

      <form action="/auth/forgot-password" method="POST" class="space-y-4">
        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8282A4] mb-1.5">Email Address</label>
          <div class="relative">
            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[#5E5E7F]">
              <i class="fa-solid fa-envelope text-sm"></i>
            </span>
            <input type="email" name="email" required placeholder="user@nova.local"
              class="w-full pl-10 pr-3.5 py-2.5 bg-[#2B2B40]/70 border border-[#42425B] rounded-[7px] text-[#F4F4F4] placeholder-[#5E5E7F] text-sm focus:outline-none focus:border-[#4A35CF] focus:ring-1 focus:ring-[#4A35CF] transition-all">
          </div>
        </div>

        <button type="submit" class="w-full py-3 px-4 rounded-[7px] bg-[#4A35CF] hover:bg-[#5F48E8] text-white font-semibold text-sm shadow-lg shadow-[#4A35CF]/30 transition-all flex items-center justify-center">
          <span>Send Reset Instructions</span>
          <i class="fa-solid fa-paper-plane ml-2 text-xs"></i>
        </button>

        <div class="text-center pt-2">
          <a href="/auth/login" class="text-xs text-[#7D6BF2] hover:text-white transition-colors">
            <i class="fa-solid fa-arrow-left mr-1"></i> Back to Sign In
          </a>
        </div>
      </form>
    </div>
  </div>

</body>
</html>
