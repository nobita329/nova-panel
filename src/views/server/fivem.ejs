<%- include('../layouts/header') %>
<%- include('./layout') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
  
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
    <div>
      <div class="flex items-center space-x-2">
        <div class="w-8 h-8 rounded-[8px] bg-rose-500/20 border border-rose-500/40 flex items-center justify-center text-rose-400">
          <i class="fa-solid fa-car-burst text-sm"></i>
        </div>
        <h2 class="text-xl font-bold text-[#F4F4F4] tracking-tight font-header">FiveM Server Utilities & Artifacts</h2>
      </div>
      <p class="text-xs text-[#8282A4] mt-1">Manage txAdmin integration, cache cleaning, and FiveM server artifact builds.</p>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
    
    <!-- txAdmin Control -->
    <div class="arix-card p-5 flex flex-col justify-between">
      <div>
        <div class="flex items-center space-x-3 mb-3">
          <div class="w-10 h-10 rounded-[8px] bg-[#1D1D37] border border-[#42425B] flex items-center justify-center text-[#7D6BF2]">
            <i class="fa-solid fa-shield-virus text-lg"></i>
          </div>
          <div>
            <h3 class="text-sm font-bold text-white font-header">txAdmin Management</h3>
            <span class="text-xs text-[#8282A4]">Complete FiveM web management interface</span>
          </div>
        </div>
        <p class="text-xs text-[#8282A4] mb-4">Enable or disable txAdmin embedded within your FiveM container and open the web dashboard.</p>
      </div>

      <div class="pt-4 border-t border-[#42425B] flex items-center justify-between">
        <span class="text-xs text-[#D5D5DB]">Status: <strong class="text-emerald-400">Ready</strong></span>
        <div class="space-x-2">
          <button onclick="toggleTxAdmin()" class="arix-btn arix-btn-primary text-xs font-semibold">
            <i class="fa-solid fa-power-off mr-1"></i> Activate txAdmin
          </button>
          <a href="http://<%= server.primary_port ? 'localhost' : '127.0.0.1' %>:40120" target="_blank" class="arix-btn arix-btn-secondary text-xs">
            Open txAdmin <i class="fa-solid fa-arrow-up-right-from-square ml-1 text-[10px]"></i>
          </a>
        </div>
      </div>
    </div>

    <!-- Cache Cleaner -->
    <div class="arix-card p-5 flex flex-col justify-between">
      <div>
        <div class="flex items-center space-x-3 mb-3">
          <div class="w-10 h-10 rounded-[8px] bg-[#1D1D37] border border-[#42425B] flex items-center justify-center text-amber-400">
            <i class="fa-solid fa-broom text-lg"></i>
          </div>
          <div>
            <h3 class="text-sm font-bold text-white font-header">Server Cache Cleaner</h3>
            <span class="text-xs text-[#8282A4]">Resolve resource desync and corrupted assets</span>
          </div>
        </div>
        <p class="text-xs text-[#8282A4] mb-4">Clearing the server cache removes compiled scripts and cached resource assets. FiveM will regenerate it cleanly upon next boot.</p>
      </div>

      <div class="pt-4 border-t border-[#42425B] flex items-center justify-between">
        <span class="text-xs text-[#8282A4]">Path: <code class="text-[#D5D5DB]">/cache</code></span>
        <button onclick="clearCache(this)" class="arix-btn arix-btn-danger text-xs font-semibold">
          <i class="fa-solid fa-trash-can mr-1"></i> Clear Cache
        </button>
      </div>
    </div>

  </div>

  <!-- FiveM Artifacts Section -->
  <div class="arix-card p-5">
    <div class="flex items-center justify-between mb-4 pb-3 border-b border-[#42425B]">
      <div>
        <h3 class="text-sm font-bold text-white font-header">FiveM Server Artifacts</h3>
        <p class="text-xs text-[#8282A4]">Select and switch to official CitizenFX server builds.</p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      <!-- Recommended Artifact -->
      <div class="p-4 rounded-[10px] bg-[#16162C] border border-[#4A35CF] flex flex-col justify-between relative shadow-lg shadow-[#4A35CF]/10">
        <div class="absolute -top-2.5 right-3 bg-[#4A35CF] text-white text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full">Recommended</div>
        <div>
          <h4 class="text-sm font-bold text-white font-mono mb-1"><%= artifacts.recommended.id %></h4>
          <span class="text-xs text-emerald-400 font-semibold"><i class="fa-solid fa-circle-check mr-1 text-[10px]"></i> Latest Master Build</span>
        </div>
        <button onclick="installArtifact('<%= artifacts.recommended.buildId %>', this)" class="arix-btn arix-btn-primary text-xs font-semibold w-full mt-4">
          Install Build
        </button>
      </div>

      <!-- Optional Artifact -->
      <div class="p-4 rounded-[10px] bg-[#16162C] border border-[#42425B] flex flex-col justify-between relative">
        <div class="absolute -top-2.5 right-3 bg-amber-500/20 text-amber-400 border border-amber-500/30 text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full">Optional</div>
        <div>
          <h4 class="text-sm font-bold text-white font-mono mb-1"><%= artifacts.optional.id %></h4>
          <span class="text-xs text-[#8282A4]">Stable Alternative</span>
        </div>
        <button onclick="installArtifact('<%= artifacts.optional.buildId %>', this)" class="arix-btn arix-btn-secondary text-xs font-semibold w-full mt-4">
          Install Build
        </button>
      </div>

      <!-- Older Artifacts -->
      <% Object.entries(artifacts.allVersions).forEach(([ver, item]) => { %>
        <div class="p-4 rounded-[10px] bg-[#16162C] border border-[#42425B] flex flex-col justify-between">
          <div>
            <h4 class="text-sm font-bold text-white font-mono mb-1"><%= item.id %></h4>
            <span class="text-xs text-[#8282A4]"><%= new Date(item.releaseDate).toLocaleDateString() %></span>
          </div>
          <button onclick="installArtifact('<%= item.buildId %>', this)" class="arix-btn arix-btn-secondary text-xs font-semibold w-full mt-4">
            Install Build
          </button>
        </div>
      <% }) %>
    </div>
  </div>

</div>

<script>
  async function toggleTxAdmin() {
    try {
      const res = await fetch(`/server/<%= server.id %>/api/fivem/txadmin`, { method: 'POST' });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed');
      alert('txAdmin activated! Ensure port 40120 is allocated.');
    } catch (e) {
      alert(`Error: ${e.message}`);
    }
  }

  async function clearCache(btn) {
    if (!confirm('Are you sure you want to clear the server cache?')) return;
    btn.disabled = true;
    try {
      const res = await fetch(`/server/<%= server.id %>/api/fivem/cache`, { method: 'POST' });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed');
      alert('Cache cleared successfully!');
      btn.disabled = false;
    } catch (e) {
      alert(`Error: ${e.message}`);
      btn.disabled = false;
    }
  }

  async function installArtifact(buildId, btn) {
    if (!confirm(`Switch FiveM server artifact to build ${buildId}?`)) return;
    btn.disabled = true;
    btn.innerHTML = `<i class="fa-solid fa-circle-notch fa-spin mr-1"></i> Installing...`;
    try {
      const res = await fetch(`/server/<%= server.id %>/api/fivem/artifacts`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ buildId })
      });
      if (!res.ok) throw new Error('Failed to install artifact');
      alert(`FiveM artifact ${buildId} configured. Please restart or reinstall your server.`);
      window.location.reload();
    } catch (e) {
      alert(`Error: ${e.message}`);
      btn.disabled = false;
      btn.innerHTML = 'Install Build';
    }
  }
</script>

<%- include('../layouts/footer') %>
