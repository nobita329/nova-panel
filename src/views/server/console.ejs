<%- include('../layouts/header') %>
<%- include('./layout') %>

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">

  <!-- Live Stats Row -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
    <div class="arix-card p-4">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold uppercase tracking-wider text-[#8282A4]">CPU Usage</span>
        <i class="fa-solid fa-microchip text-[#7D6BF2] text-sm"></i>
      </div>
      <p id="stat-cpu" class="text-xl font-bold font-mono text-[#F4F4F4] mt-1"><%= stats.cpu || '0%' %></p>
      <div class="w-full bg-[#040519] rounded-full h-1.5 mt-2 overflow-hidden border border-[#42425B]/40">
        <div id="stat-cpu-bar" class="bg-[#4A35CF] h-1.5 rounded-full transition-all duration-500" style="width: <%= stats.cpu || '0%' %>"></div>
      </div>
    </div>

    <div class="arix-card p-4">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold uppercase tracking-wider text-[#8282A4]">Memory</span>
        <i class="fa-solid fa-memory text-[#7D6BF2] text-sm"></i>
      </div>
      <p id="stat-mem" class="text-xl font-bold font-mono text-[#F4F4F4] mt-1"><%= stats.memory || '0 MB' %></p>
      <div class="w-full bg-[#040519] rounded-full h-1.5 mt-2 overflow-hidden border border-[#42425B]/40">
        <div id="stat-mem-bar" class="bg-[#5E46E5] h-1.5 rounded-full transition-all duration-500" style="width: 10%"></div>
      </div>
    </div>

    <div class="arix-card p-4">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold uppercase tracking-wider text-[#8282A4]">Network I/O</span>
        <i class="fa-solid fa-arrow-right-arrow-left text-emerald-400 text-sm"></i>
      </div>
      <p id="stat-net" class="text-base font-bold font-mono text-[#F4F4F4] mt-1 truncate"><%= stats.netIO || '0 B / 0 B' %></p>
      <span class="text-[10px] text-[#8282A4] block mt-1">Inbound / Outbound</span>
    </div>

    <div class="arix-card p-4">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold uppercase tracking-wider text-[#8282A4]">Block I/O</span>
        <i class="fa-solid fa-hard-drive text-amber-400 text-sm"></i>
      </div>
      <p id="stat-block" class="text-base font-bold font-mono text-[#F4F4F4] mt-1 truncate"><%= stats.blockIO || '0 B / 0 B' %></p>
      <span class="text-[10px] text-[#8282A4] block mt-1">Read / Write</span>
    </div>
  </div>

  <!-- Terminal Container Card -->
  <div class="arix-card overflow-hidden shadow-2xl flex flex-col border border-[#42425B]">
    
    <!-- Terminal Header Bar -->
    <div class="bg-[#0B0D2A] px-4 py-3 border-b border-[#42425B] flex items-center justify-between text-xs">
      <div class="flex items-center space-x-2">
        <span class="w-3 h-3 rounded-full bg-rose-500/80 inline-block"></span>
        <span class="w-3 h-3 rounded-full bg-amber-500/80 inline-block"></span>
        <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block"></span>
        <span class="font-mono text-[#8282A4] ml-2">nova@container:~# console</span>
      </div>

      <div class="flex items-center space-x-4">
        <label class="flex items-center cursor-pointer text-[#8282A4] hover:text-[#F4F4F4] transition-colors select-none">
          <input type="checkbox" id="auto-scroll" checked class="mr-2 rounded bg-[#040519] border-[#42425B] text-[#4A35CF] focus:ring-0">
          Auto Scroll
        </label>
        <button onclick="clearConsole()" class="text-[#8282A4] hover:text-[#F4F4F4] transition-colors" title="Clear Console">
          <i class="fa-solid fa-eraser mr-1"></i> Clear
        </button>
      </div>
    </div>

    <!-- Terminal Log Stream Output Area -->
    <pre id="terminal" class="p-4 font-mono text-xs sm:text-sm text-[#D5D5DB] bg-[#060911] h-[500px] overflow-y-auto whitespace-pre-wrap break-all leading-relaxed"><%= initialLogs %></pre>

    <!-- Terminal Command Input Bar -->
    <form id="command-form" class="bg-[#0B0D2A] border-t border-[#42425B] p-2.5 flex items-center space-x-2">
      <span class="text-[#7D6BF2] font-mono pl-2 font-bold">&gt;</span>
      <input type="text" id="command-input" placeholder="Type a server command and press Enter..." autocomplete="off"
        class="flex-1 bg-transparent border-0 text-[#F4F4F4] placeholder-[#5E5E7F] font-mono text-sm focus:outline-none focus:ring-0">
      <button type="submit" class="arix-btn arix-btn-primary text-xs py-1.5 px-4 font-semibold">
        Send <i class="fa-solid fa-paper-plane ml-1 text-[10px]"></i>
      </button>
    </form>

  </div>

</main>

<script>
  const serverId = <%= server.id %>;
  const terminal = document.getElementById('terminal');
  const autoScroll = document.getElementById('auto-scroll');
  const commandForm = document.getElementById('command-form');
  const commandInput = document.getElementById('command-input');

  function scrollToBottom() {
    if (autoScroll.checked) {
      terminal.scrollTop = terminal.scrollHeight;
    }
  }

  function clearConsole() {
    terminal.innerText = '';
  }

  scrollToBottom();

  // Connect WebSocket
  const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
  const wsUrl = `${protocol}//${window.location.host}/ws/console?serverId=${serverId}`;
  let ws;

  function connectWs() {
    ws = new WebSocket(wsUrl);

    ws.onopen = () => {
      console.log('Connected to Nova Console WebSocket');
    };

    ws.onmessage = (event) => {
      try {
        const msg = JSON.parse(event.data);
        if (msg.event === 'log') {
          terminal.innerText += msg.data;
          scrollToBottom();
        } else if (msg.event === 'stats') {
          updateStats(msg.data);
        }
      } catch (e) {
        terminal.innerText += event.data + '\n';
        scrollToBottom();
      }
    };

    ws.onclose = () => {
      console.log('WebSocket disconnected, reconnecting in 3s...');
      setTimeout(connectWs, 3000);
    };

    ws.onerror = (err) => {
      console.error('WebSocket error:', err);
    };
  }

  function updateStats(data) {
    if (data.cpu) {
      document.getElementById('stat-cpu').innerText = data.cpu;
      const cpuVal = parseFloat(data.cpu) || 0;
      document.getElementById('stat-cpu-bar').style.width = Math.min(cpuVal, 100) + '%';
    }
    if (data.memory) {
      document.getElementById('stat-mem').innerText = data.memory;
    }
    if (data.netIO) {
      document.getElementById('stat-net').innerText = data.netIO;
    }
    if (data.blockIO) {
      document.getElementById('stat-block').innerText = data.blockIO;
    }
  }

  connectWs();

  // Handle Command Submission
  commandForm.addEventListener('submit', (e) => {
    e.preventDefault();
    const cmd = commandInput.value.trim();
    if (!cmd) return;

    if (ws && ws.readyState === WebSocket.OPEN) {
      ws.send(JSON.stringify({ event: 'command', command: cmd }));
      terminal.innerText += `\n> ${cmd}\n`;
      scrollToBottom();
      commandInput.value = '';
    } else {
      fetch(`/server/${serverId}/command`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ command: cmd })
      }).then(() => {
        terminal.innerText += `\n> ${cmd}\n`;
        scrollToBottom();
        commandInput.value = '';
      });
    }
  });
</script>

<%- include('../layouts/footer') %>
