<%- include('../layouts/header') %>
<%- include('./layout') %>

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">

  <div class="arix-card overflow-hidden shadow-2xl flex flex-col border border-[#42425B]">
    
    <!-- Editor Header Bar -->
    <div class="bg-[#0B0D2A] px-4 py-3 border-b border-[#42425B] flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <a href="/server/<%= server.id %>/files?path=<%= encodeURIComponent(dirPath) %>" class="arix-btn arix-btn-secondary text-xs py-1 px-3">
          <i class="fa-solid fa-arrow-left mr-1"></i> Back
        </a>
        <span class="font-mono text-sm text-[#F4F4F4] font-semibold flex items-center">
          <i class="fa-solid fa-file-code text-[#7D6BF2] mr-2"></i>
          <%= fileName %>
        </span>
        <span id="save-status" class="text-xs text-[#8282A4] font-mono"></span>
      </div>

      <div class="flex items-center space-x-2">
        <button id="btn-save" onclick="saveFile(false)" class="arix-btn arix-btn-primary text-xs py-1.5 px-4 font-semibold">
          <i class="fa-solid fa-floppy-disk mr-1"></i> Save
        </button>
        <button onclick="saveFile(true)" class="arix-btn arix-btn-secondary text-xs py-1.5 px-3">
          Save & Exit
        </button>
      </div>
    </div>

    <!-- Code Editor Textarea -->
    <textarea id="code-editor" class="w-full h-[560px] p-4 bg-[#060911] text-[#D5D5DB] font-mono text-xs sm:text-sm focus:outline-none resize-none leading-relaxed border-0" spellcheck="false"><%= content %></textarea>

  </div>

</main>

<script>
  const serverId = <%= server.id %>;
  const filePath = '<%= filePath %>';
  const dirPath = '<%= dirPath %>';
  const editor = document.getElementById('code-editor');
  const saveStatus = document.getElementById('save-status');

  // Support Tab key inside editor
  editor.addEventListener('keydown', function(e) {
    if (e.key === 'Tab') {
      e.preventDefault();
      const start = this.selectionStart;
      const end = this.selectionEnd;
      this.value = this.value.substring(0, start) + '    ' + this.value.substring(end);
      this.selectionStart = this.selectionEnd = start + 4;
    } else if ((e.ctrlKey || e.metaKey) && e.key === 's') {
      e.preventDefault();
      saveFile(false);
    }
  });

  async function saveFile(andExit = false) {
    saveStatus.innerText = 'Saving...';
    saveStatus.className = 'text-xs text-amber-400 font-mono';

    try {
      const res = await fetch(`/server/${serverId}/files/save`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ filePath, content: editor.value })
      });
      const data = await res.json();
      if (data.success) {
        saveStatus.innerText = 'Saved at ' + new Date().toLocaleTimeString();
        saveStatus.className = 'text-xs text-emerald-400 font-mono';
        if (andExit) {
          window.location.href = `/server/${serverId}/files?path=${encodeURIComponent(dirPath)}&success=File%20saved`;
        }
      } else {
        saveStatus.innerText = 'Error: ' + data.error;
        saveStatus.className = 'text-xs text-rose-400 font-mono';
      }
    } catch (e) {
      saveStatus.innerText = 'Network Error';
      saveStatus.className = 'text-xs text-rose-400 font-mono';
    }
  }
</script>

<%- include('../layouts/footer') %>
