<%- include('../layouts/header') %>

<main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">

  <!-- Arix Welcome & Action Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
    <div>
      <h1 class="text-2xl sm:text-3xl font-bold text-[#F4F4F4] tracking-tight font-header flex items-center">
        Welcome back, <%= user.first_name || user.username %> 👋
      </h1>
      <p class="text-sm text-[#8282A4] mt-1">Manage and monitor all your cloud server instances in real-time.</p>
    </div>

    <% if (user.is_admin) { %>
      <div class="flex items-center space-x-3">
        <a href="/admin/servers/new" class="arix-btn arix-btn-primary shadow-lg shadow-[#4A35CF]/25 font-semibold text-sm">
          <i class="fa-solid fa-plus text-xs"></i> Deploy New Server
        </a>
      </div>
    <% } %>
  </div>

  <!-- Arix Metric Statistics Cards -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    
    <div class="arix-card p-5 flex items-center space-x-4">
      <div class="w-12 h-12 rounded-[10px] bg-[#4A35CF]/20 border border-[#4A35CF]/40 text-[#7D6BF2] flex items-center justify-center text-xl flex-shrink-0">
        <i class="fa-solid fa-server"></i>
      </div>
      <div>
        <p class="text-[11px] font-semibold uppercase tracking-wider text-[#8282A4]">Total Servers</p>
        <p class="text-2xl font-bold text-[#F4F4F4] mt-0.5"><%= stats.totalServers %></p>
      </div>
    </div>

    <div class="arix-card p-5 flex items-center space-x-4">
      <div class="w-12 h-12 rounded-[10px] bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 flex items-center justify-center text-xl flex-shrink-0">
        <i class="fa-solid fa-circle-check"></i>
      </div>
      <div>
        <p class="text-[11px] font-semibold uppercase tracking-wider text-[#8282A4]">Online Active</p>
        <p class="text-2xl font-bold text-[#F4F4F4] mt-0.5"><%= stats.onlineServers %></p>
      </div>
    </div>

    <div class="arix-card p-5 flex items-center space-x-4">
      <div class="w-12 h-12 rounded-[10px] bg-indigo-500/15 border border-indigo-500/30 text-indigo-400 flex items-center justify-center text-xl flex-shrink-0">
        <i class="fa-solid fa-memory"></i>
      </div>
      <div>
        <p class="text-[11px] font-semibold uppercase tracking-wider text-[#8282A4]">Allocated RAM</p>
        <p class="text-2xl font-bold text-[#F4F4F4] mt-0.5">
          <%= (stats.totalMemory / 1024).toFixed(1) %> <span class="text-xs font-normal text-[#8282A4]">GB</span>
        </p>
      </div>
    </div>

    <div class="arix-card p-5 flex items-center space-x-4">
      <div class="w-12 h-12 rounded-[10px] bg-amber-500/15 border border-amber-500/30 text-amber-400 flex items-center justify-center text-xl flex-shrink-0">
        <i class="fa-solid fa-hard-drive"></i>
      </div>
      <div>
        <p class="text-[11px] font-semibold uppercase tracking-wider text-[#8282A4]">Allocated SSD</p>
        <p class="text-2xl font-bold text-[#F4F4F4] mt-0.5">
          <%= (stats.totalDisk / 1024).toFixed(1) %> <span class="text-xs font-normal text-[#8282A4]">GB</span>
        </p>
      </div>
    </div>

  </div>

  <!-- Arix Server Instances List -->
  <div class="mb-4 flex items-center justify-between">
    <h2 class="text-lg font-bold text-[#F4F4F4] tracking-tight font-header flex items-center">
      <i class="fa-solid fa-cubes text-[#7D6BF2] mr-2"></i>
      Server Instances
    </h2>
    <span class="text-xs text-[#8282A4]"><%= servers.length %> instance<%= servers.length === 1 ? '' : 's' %> configured</span>
  </div>

  <% if (servers.length === 0) { %>
    <div class="arix-card p-12 text-center">
      <img src="/arix/images/server_installing.svg" alt="No servers" class="w-24 h-24 mx-auto mb-4 opacity-75">
      <h3 class="text-lg font-bold text-[#F4F4F4] font-header">No Servers Found</h3>
      <p class="text-sm text-[#8282A4] mt-1 max-w-sm mx-auto">You do not have any server instances deployed yet.</p>
      <% if (user.is_admin) { %>
        <div class="mt-6">
          <a href="/admin/servers/new" class="arix-btn arix-btn-primary">
            <i class="fa-solid fa-plus mr-1"></i> Create Server Now
          </a>
        </div>
      <% } %>
    </div>
  <% } else { %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      <% servers.forEach(server => { %>
        <div class="arix-card p-5 flex flex-col justify-between group relative overflow-hidden">
          
          <!-- Arix Right Edge Status Bar Indicator -->
          <div class="arix-status-indicator <%= server.status === 'online' ? 'arix-status-online' : (server.status === 'starting' ? 'arix-status-starting' : 'arix-status-offline') %>"></div>

          <div>
            <!-- Card Header: Icon, Name & Status -->
            <div class="flex items-start justify-between mb-4">
              <div class="flex items-center space-x-3">
                <div class="w-11 h-11 rounded-[10px] bg-[#4A35CF]/15 border border-[#4A35CF]/30 flex items-center justify-center text-[#7D6BF2] shadow-sm">
                  <% if (server.nest_id === 1) { %>
                    <i class="fa-solid fa-cube text-lg"></i>
                  <% } else if (server.nest_id === 2) { %>
                    <i class="fa-brands fa-node-js text-lg"></i>
                  <% } else if (server.nest_id === 3) { %>
                    <i class="fa-brands fa-python text-lg"></i>
                  <% } else { %>
                    <i class="fa-solid fa-server text-lg"></i>
                  <% } %>
                </div>
                <div>
                  <h3 class="font-bold text-[#F4F4F4] group-hover:text-[#7D6BF2] transition-colors truncate max-w-[170px] font-header">
                    <a href="/server/<%= server.id %>/console"><%= server.name %></a>
                  </h3>
                  <p class="text-xs text-[#8282A4] truncate"><%= server.egg_name || 'Game Server' %></p>
                </div>
              </div>

              <!-- Status Badge -->
              <span id="badge-<%= server.id %>" class="px-2.5 py-0.5 rounded-full text-[10px] font-bold tracking-wide uppercase mr-2 <%= server.status === 'online' ? 'arix-badge-success' : (server.status === 'starting' ? 'arix-badge-warning' : 'arix-badge-danger') %>">
                <i class="fa-solid fa-circle text-[6px] mr-1 <%= server.status === 'online' ? 'text-emerald-400 animate-pulse' : (server.status === 'starting' ? 'text-amber-400 animate-spin' : 'text-rose-400') %>"></i>
                <%= server.status %>
              </span>
            </div>

            <!-- Server Specs Pill Grid -->
            <div class="grid grid-cols-3 gap-2 py-2.5 px-3 bg-[#0B0D2A]/80 rounded-[7px] border border-[#42425B]/60 text-xs mb-4">
              <div>
                <span class="text-[#5E5E7F] block text-[10px] uppercase font-semibold">Memory</span>
                <span class="font-mono text-[#F4F4F4] font-semibold"><%= server.memory_limit %> MB</span>
              </div>
              <div>
                <span class="text-[#5E5E7F] block text-[10px] uppercase font-semibold">CPU</span>
                <span class="font-mono text-[#F4F4F4] font-semibold"><%= server.cpu_limit %>%</span>
              </div>
              <div>
                <span class="text-[#5E5E7F] block text-[10px] uppercase font-semibold">Port</span>
                <span class="font-mono text-[#F4F4F4] font-semibold"><%= server.primary_port %></span>
              </div>
            </div>
          </div>

          <!-- Bottom Action Buttons -->
          <div class="flex items-center justify-between pt-3 border-t border-[#42425B]/60">
            <!-- Quick Power Controls -->
            <div class="flex items-center space-x-1.5">
              <button onclick="quickPower(<%= server.id %>, 'start')" title="Start Server" class="w-8 h-8 rounded-[7px] bg-emerald-500/10 hover:bg-emerald-500/25 text-emerald-400 border border-emerald-500/20 flex items-center justify-center text-xs transition-colors">
                <i class="fa-solid fa-play"></i>
              </button>
              <button onclick="quickPower(<%= server.id %>, 'restart')" title="Restart Server" class="w-8 h-8 rounded-[7px] bg-amber-500/10 hover:bg-amber-500/25 text-amber-400 border border-amber-500/20 flex items-center justify-center text-xs transition-colors">
                <i class="fa-solid fa-rotate-right"></i>
              </button>
              <button onclick="quickPower(<%= server.id %>, 'stop')" title="Stop Server" class="w-8 h-8 rounded-[7px] bg-rose-500/10 hover:bg-rose-500/25 text-rose-400 border border-rose-500/20 flex items-center justify-center text-xs transition-colors">
                <i class="fa-solid fa-stop"></i>
              </button>
            </div>

            <!-- Manage Server Link -->
            <a href="/server/<%= server.id %>/console" class="arix-btn arix-btn-secondary text-xs font-semibold py-1.5 px-3">
              Manage Server
              <i class="fa-solid fa-arrow-right text-[10px]"></i>
            </a>
          </div>

        </div>
      <% }) %>
    </div>
  <% } %>

</main>

<script>
  async function quickPower(serverId, action) {
    const badge = document.getElementById(`badge-${serverId}`);
    if (badge) {
      badge.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase arix-badge-warning mr-2';
      badge.innerHTML = `<i class="fa-solid fa-circle text-[6px] mr-1 text-amber-400 animate-spin"></i> ${action}...`;
    }

    if (action === 'start') window.playArixSound('online');
    if (action === 'stop') window.playArixSound('offline');

    try {
      const res = await fetch(`/server/${serverId}/power`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action })
      });
      const data = await res.json();
      if (!data.success) {
        alert('Action error: ' + (data.error || 'Failed'));
      }
    } catch (e) {
      console.error('Quick power failed:', e);
    }
  }
</script>

<%- include('../layouts/footer') %>
