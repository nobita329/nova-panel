<%- include('../layouts/header') %>

<main class="flex-1 max-w-5xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">

  <div class="mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-[#F4F4F4] tracking-tight font-header">API Credentials</h1>
      <p class="text-sm text-[#8282A4] mt-1">Manage personal API keys for automated control of your servers.</p>
    </div>

    <div class="flex items-center space-x-2">
      <a href="/account" class="arix-btn arix-btn-secondary text-xs py-1.5 px-3">
        <i class="fa-solid fa-user-gear"></i> Profile
      </a>
      <a href="/account/api" class="arix-btn arix-btn-primary text-xs py-1.5 px-3">
        <i class="fa-solid fa-key"></i> API Keys
      </a>
      <a href="/account/ssh-keys" class="arix-btn arix-btn-secondary text-xs py-1.5 px-3">
        <i class="fa-solid fa-terminal"></i> SSH Keys
      </a>
      <a href="/account/activity" class="arix-btn arix-btn-secondary text-xs py-1.5 px-3">
        <i class="fa-solid fa-list-check"></i> Activity
      </a>
    </div>
  </div>

  <% if (newKey) { %>
    <div class="mb-6 p-4 rounded-[10px] bg-[#f59e0b]/10 border border-[#f59e0b]/30 text-amber-300 text-sm shadow-xl">
      <div class="font-bold flex items-center mb-1 text-[#F4F4F4]">
        <i class="fa-solid fa-key mr-2 text-amber-400"></i>
        New API Key Created! Copy it now:
      </div>
      <p class="text-xs text-amber-400/80 mb-2">This token will NOT be shown again.</p>
      <div class="bg-[#0B0D2A] p-3 rounded-[7px] border border-[#42425B] font-mono text-xs select-all text-[#7D6BF2] break-all cursor-pointer hover:border-[#4A35CF]"
           onclick="window.copyToClipboard('<%= newKey %>', this)">
        <%= newKey %>
      </div>
    </div>
  <% } %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- Create API Key -->
    <div class="arix-card p-6 shadow-xl border border-[#42425B]">
      <h2 class="text-base font-bold text-[#F4F4F4] mb-4 flex items-center font-header">
        <i class="fa-solid fa-plus-circle text-[#7D6BF2] mr-2"></i>
        Generate New Key
      </h2>

      <form action="/account/api" method="POST" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-[#8282A4] mb-1.5">Description / Purpose</label>
          <input type="text" name="description" placeholder="e.g. Discord Bot / Backup Script" required class="arix-input">
        </div>

        <button type="submit" class="w-full arix-btn arix-btn-primary text-xs py-2 px-4 font-semibold">
          Create API Key
        </button>
      </form>
    </div>

    <!-- API Keys List -->
    <div class="lg:col-span-2 arix-card p-6 shadow-xl border border-[#42425B]">
      <h2 class="text-base font-bold text-[#F4F4F4] mb-4 flex items-center font-header">
        <i class="fa-solid fa-key text-[#7D6BF2] mr-2"></i>
        Active Keys
      </h2>

      <% if (keys.length === 0) { %>
        <div class="text-center py-10 text-[#8282A4] text-sm">
          <i class="fa-solid fa-key text-3xl mb-2 text-[#42425B] block"></i>
          No API keys generated yet.
        </div>
      <% } else { %>
        <div class="space-y-3">
          <% keys.forEach(k => { %>
            <div class="p-4 bg-[#0B0D2A] rounded-[10px] border border-[#42425B] flex items-center justify-between">
              <div>
                <p class="font-semibold text-[#F4F4F4] text-sm"><%= k.description || 'API Key' %></p>
                <p class="font-mono text-xs text-[#8282A4] mt-0.5">ID: <code class="text-[#D5D5DB]"><%= k.identifier %></code></p>
                <p class="text-[11px] text-[#5E5E7F] mt-0.5">Created: <%= new Date(k.created_at).toLocaleDateString() %></p>
              </div>

              <form action="/account/api/delete" method="POST">
                <input type="hidden" name="id" value="<%= k.id %>">
                <button type="submit" class="arix-btn arix-btn-danger text-xs py-1.5 px-3" title="Revoke Key">
                  <i class="fa-solid fa-trash-can"></i>
                </button>
              </form>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

  </div>

</main>

<%- include('../layouts/footer') %>
