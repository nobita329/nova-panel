<%- include('../layouts/header') %>

<div class="flex-1 flex">
  <%- include('../layouts/admin-sidebar') %>

  <main class="flex-1 p-6 lg:p-8 overflow-y-auto">

    <div class="mb-6 flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold text-[#F4F4F4] tracking-tight font-header">Add Egg to <%= nest.name %></h1>
        <p class="text-sm text-[#8282A4] mt-1">Configure container image, startup command, and default variables.</p>
      </div>
      <a href="/admin/nests/<%= nest.id %>/eggs" class="arix-btn arix-btn-secondary text-xs py-1.5 px-3">
        &larr; Back to Eggs
      </a>
    </div>

    <div class="arix-card p-6 sm:p-8 shadow-xl max-w-2xl border border-[#42425B]">
      <form action="/admin/nests/<%= nest.id %>/eggs/new" method="POST" class="space-y-4">
        
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-[#8282A4] mb-1.5">Egg Name</label>
          <input type="text" name="name" placeholder="e.g. Purpur or Express.js" required autofocus class="arix-input">
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-[#8282A4] mb-1.5">Description</label>
          <input type="text" name="description" placeholder="A short description of this software" class="arix-input">
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-[#8282A4] mb-1.5">Default Docker Image</label>
          <input type="text" name="docker_image" placeholder="ghcr.io/pterodactyl/yolks:java_25" required
            class="arix-input font-mono text-xs">
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-[#8282A4] mb-1.5">Default Startup Command</label>
          <input type="text" name="startup_command" placeholder="java -Xms128M -Xmx{{SERVER_MEMORY}}M -jar server.jar nogui" required
            class="arix-input font-mono text-xs">
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-[#8282A4] mb-1.5">Default Environment JSON (Optional)</label>
          <textarea name="default_variables" rows="3" placeholder='{"SERVER_JARFILE": "server.jar"}'
            class="arix-textarea font-mono text-xs"></textarea>
        </div>

        <div class="pt-4 border-t border-[#42425B]/40 flex items-center justify-end space-x-3">
          <a href="/admin/nests/<%= nest.id %>/eggs" class="arix-btn arix-btn-secondary text-xs py-2 px-4">Cancel</a>
          <button type="submit" class="arix-btn arix-btn-primary text-xs py-2 px-5 font-semibold">
            Create Egg
          </button>
        </div>
      </form>
    </div>

  </main>
</div>

<%- include('../layouts/footer') %>
