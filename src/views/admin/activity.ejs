<%- include('../layouts/header') %>

<div class="flex-1 flex">
  <%- include('../layouts/admin-sidebar') %>

  <main class="flex-1 p-6 lg:p-8 overflow-y-auto">

    <div class="mb-6">
      <h1 class="text-2xl font-bold text-[#F4F4F4] tracking-tight flex items-center font-header">
        <i class="fa-solid fa-list-check text-[#7D6BF2] mr-2.5"></i>
        System Activity Audit
      </h1>
      <p class="text-sm text-[#8282A4] mt-1">Complete audit trails of all system, administrative, and user events.</p>
    </div>

    <div class="arix-card overflow-hidden shadow-xl border border-[#42425B]">
      <div class="overflow-x-auto max-h-[640px]">
        <table class="arix-table">
          <thead class="sticky top-0 bg-[#0B0D2A]">
            <tr>
              <th class="py-3 px-4">Event</th>
              <th class="py-3 px-4">User</th>
              <th class="py-3 px-4">Server</th>
              <th class="py-3 px-4">Details</th>
              <th class="py-3 px-4">IP Address</th>
              <th class="py-3 px-4">Timestamp</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#42425B]/40 text-xs">
            <% logs.forEach(log => { %>
              <tr class="hover:bg-white/[0.02] transition-colors">
                <td class="py-3.5 px-4">
                  <span class="px-2.5 py-0.5 rounded-[7px] text-[11px] font-mono font-semibold bg-[#4A35CF]/20 text-[#7D6BF2] border border-[#4A35CF]/30">
                    <%= log.event %>
                  </span>
                </td>
                <td class="py-3.5 px-4 font-semibold text-[#F4F4F4]"><%= log.username || 'System' %></td>
                <td class="py-3.5 px-4 font-mono text-[#8282A4]"><%= log.server_name || '-' %></td>
                <td class="py-3.5 px-4 font-mono text-[#D5D5DB] text-xs truncate max-w-xs"><%= log.details || '-' %></td>
                <td class="py-3.5 px-4 font-mono text-[#8282A4] text-xs"><%= log.ip_address || '127.0.0.1' %></td>
                <td class="py-3.5 px-4 text-[#8282A4] text-xs font-sans"><%= new Date(log.created_at).toLocaleString() %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

  </main>
</div>

<%- include('../layouts/footer') %>
