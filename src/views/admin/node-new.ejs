<%- include('../layouts/header') %>

<div class="flex-1 flex">
  <%- include('../layouts/admin-sidebar') %>

  <main class="flex-1 p-6 lg:p-8 overflow-y-auto">

    <div class="mb-6 flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold text-[#F4F4F4] tracking-tight font-header">Create New Node</h1>
        <p class="text-sm text-[#8282A4] mt-1">Add a new Docker host to the Nova infrastructure.</p>
      </div>
      <a href="/admin/nodes" class="arix-btn arix-btn-secondary text-xs py-1.5 px-3">
        &larr; Back to Nodes
      </a>
    </div>

    <div class="arix-card p-6 sm:p-8 shadow-xl max-w-2xl border border-[#42425B]">
      <form action="/admin/nodes/new" method="POST" class="space-y-4">
        
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-[#8282A4] mb-1.5">Node Name</label>
            <input type="text" name="name" placeholder="e.g. EU-Node-01" required autofocus class="arix-input">
          </div>
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-[#8282A4] mb-1.5">Location</label>
            <select name="location_id" class="arix-select">
              <% locations.forEach(l => { %>
                <option value="<%= l.id %>"><%= l.short_code %> - <%= l.description %></option>
              <% }) %>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-[#8282A4] mb-1.5">FQDN / Host IP</label>
          <input type="text" name="fqdn" placeholder="127.0.0.1 or node1.novapanel.io" required
            class="arix-input font-mono text-xs">
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-[#8282A4] mb-1.5">Daemon Port</label>
            <input type="number" name="daemon_port" value="3003" required
              class="arix-input font-mono text-xs">
          </div>
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-[#8282A4] mb-1.5">SFTP Port</label>
            <input type="number" name="sftp_port" value="3004" required
              class="arix-input font-mono text-xs">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-[#8282A4] mb-1.5">Total Memory Limit (MB)</label>
            <input type="number" name="memory_limit" value="16384" step="1024" required
              class="arix-input font-mono text-xs">
          </div>
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-[#8282A4] mb-1.5">Total Disk Limit (MB)</label>
            <input type="number" name="disk_limit" value="102400" step="1024" required
              class="arix-input font-mono text-xs">
          </div>
        </div>

        <div class="pt-4 border-t border-[#42425B]/40 flex items-center justify-end space-x-3">
          <a href="/admin/nodes" class="arix-btn arix-btn-secondary text-xs py-2 px-4">Cancel</a>
          <button type="submit" class="arix-btn arix-btn-primary text-xs py-2 px-5 font-semibold">
            Create Node
          </button>
        </div>
      </form>
    </div>

  </main>
</div>

<%- include('../layouts/footer') %>
