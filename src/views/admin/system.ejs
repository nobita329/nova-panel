<%- include('../layouts/header') %>

<div class="flex-1 flex">
  <%- include('../layouts/admin-sidebar') %>

  <main class="flex-1 p-6 lg:p-8 overflow-y-auto">

    <div class="mb-6">
      <h1 class="text-2xl font-bold text-[#F4F4F4] tracking-tight flex items-center font-header">
        <i class="fa-solid fa-circle-info text-[#7D6BF2] mr-2.5"></i>
        System Information
      </h1>
      <p class="text-sm text-[#8282A4] mt-1">Host operating system, container runtime, Node.js environment, and database metrics.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl">

      <!-- Panel & Environment -->
      <div class="arix-card p-6 shadow-xl space-y-4 border border-[#42425B] relative overflow-hidden">
        <div class="arix-status-indicator arix-status-online"></div>
        <h2 class="text-base font-bold text-[#F4F4F4] mb-2 flex items-center font-header">
          <i class="fa-solid fa-server text-[#7D6BF2] mr-2"></i>
          Panel Environment
        </h2>

        <div class="space-y-3 font-mono text-xs">
          <div class="flex items-center justify-between p-3 rounded-[8px] bg-[#0B0D2A] border border-[#42425B]">
            <span class="text-[#8282A4] font-sans">Nova Version:</span>
            <span class="text-[#F4F4F4] font-bold">1.0.0 (Arix v2.1.3)</span>
          </div>
          <div class="flex items-center justify-between p-3 rounded-[8px] bg-[#0B0D2A] border border-[#42425B]">
            <span class="text-[#8282A4] font-sans">Node.js Runtime:</span>
            <span class="text-emerald-400 font-bold"><%= system.nodeVersion %></span>
          </div>
          <div class="flex items-center justify-between p-3 rounded-[8px] bg-[#0B0D2A] border border-[#42425B]">
            <span class="text-[#8282A4] font-sans">Database Engine:</span>
            <span class="text-[#7D6BF2] font-semibold"><%= system.dbEngine %></span>
          </div>
          <div class="flex items-center justify-between p-3 rounded-[8px] bg-[#0B0D2A] border border-[#42425B]">
            <span class="text-[#8282A4] font-sans">Panel HTTP Port:</span>
            <span class="text-[#F4F4F4]">3001</span>
          </div>
          <div class="flex items-center justify-between p-3 rounded-[8px] bg-[#0B0D2A] border border-[#42425B]">
            <span class="text-[#8282A4] font-sans">REST API Port:</span>
            <span class="text-[#F4F4F4]">3003</span>
          </div>
          <div class="flex items-center justify-between p-3 rounded-[8px] bg-[#0B0D2A] border border-[#42425B]">
            <span class="text-[#8282A4] font-sans">SFTP Daemon Port:</span>
            <span class="text-[#F4F4F4]">3004</span>
          </div>
        </div>
      </div>

      <!-- Docker Container Daemon Status -->
      <div class="arix-card p-6 shadow-xl space-y-4 border border-[#42425B] relative overflow-hidden">
        <div class="arix-status-indicator arix-status-online"></div>
        <h2 class="text-base font-bold text-[#F4F4F4] mb-2 flex items-center font-header">
          <i class="fa-brands fa-docker text-cyan-400 mr-2"></i>
          Docker Daemon Status
        </h2>

        <div class="space-y-3 font-mono text-xs">
          <div class="flex items-center justify-between p-3 rounded-[8px] bg-[#0B0D2A] border border-[#42425B]">
            <span class="text-[#8282A4] font-sans">Docker State:</span>
            <% if (system.dockerRunning) { %>
              <span class="arix-badge-success text-[10px] uppercase font-bold py-0.5 px-2">Operational</span>
            <% } else { %>
              <span class="arix-badge-danger text-[10px] uppercase font-bold py-0.5 px-2">Disconnected</span>
            <% } %>
          </div>
          <div class="flex items-center justify-between p-3 rounded-[8px] bg-[#0B0D2A] border border-[#42425B]">
            <span class="text-[#8282A4] font-sans">Docker Version:</span>
            <span class="text-[#F4F4F4] truncate max-w-xs"><%= system.dockerVersion %></span>
          </div>
          <div class="flex items-center justify-between p-3 rounded-[8px] bg-[#0B0D2A] border border-[#42425B]">
            <span class="text-[#8282A4] font-sans">Architecture:</span>
            <span class="text-[#F4F4F4]"><%= system.arch %></span>
          </div>
          <div class="flex items-center justify-between p-3 rounded-[8px] bg-[#0B0D2A] border border-[#42425B]">
            <span class="text-[#8282A4] font-sans">Operating System:</span>
            <span class="text-[#F4F4F4]"><%= system.platform %> (<%= system.osRelease.slice(0, 16) %>)</span>
          </div>
          <div class="flex items-center justify-between p-3 rounded-[8px] bg-[#0B0D2A] border border-[#42425B]">
            <span class="text-[#8282A4] font-sans">System Memory:</span>
            <span class="text-[#F4F4F4]"><%= system.freeMem %> Free / <%= system.totalMem %> Total</span>
          </div>
        </div>
      </div>

    </div>

  </main>
</div>

<%- include('../layouts/footer') %>
