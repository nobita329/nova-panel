<%- include('../layouts/header') %>

<div class="flex-1 flex">
  <%- include('../layouts/admin-sidebar') %>

  <main class="flex-1 p-6 lg:p-8 overflow-y-auto">

    <div class="mb-6 flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold text-[#F4F4F4] tracking-tight font-header">Create New User</h1>
        <p class="text-sm text-[#8282A4] mt-1">Add a new client or administrator to Nova Panel.</p>
      </div>
      <a href="/admin/users" class="arix-btn arix-btn-secondary text-xs py-1.5 px-3">
        &larr; Back to Users
      </a>
    </div>

    <% if (error) { %>
      <div class="mb-5 p-3.5 rounded-[10px] arix-badge-danger w-full flex items-center justify-between">
        <div class="flex items-center">
          <i class="fa-solid fa-triangle-exclamation mr-2 text-base"></i>
          <span><%= error %></span>
        </div>
      </div>
    <% } %>

    <div class="arix-card p-6 sm:p-8 shadow-xl max-w-2xl border border-[#42425B]">
      <form action="/admin/users/new" method="POST" class="space-y-4">
        
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-[#8282A4] mb-1.5">First Name</label>
            <input type="text" name="first_name" placeholder="John" class="arix-input">
          </div>
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-[#8282A4] mb-1.5">Last Name</label>
            <input type="text" name="last_name" placeholder="Doe" class="arix-input">
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-[#8282A4] mb-1.5">Username</label>
          <input type="text" name="username" placeholder="johndoe" required autofocus class="arix-input font-mono">
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-[#8282A4] mb-1.5">Email Address</label>
          <input type="email" name="email" placeholder="john@example.com" required class="arix-input">
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-[#8282A4] mb-1.5">Password</label>
          <input type="password" name="password" placeholder="••••••••" required minlength="6" class="arix-input">
        </div>

        <div class="pt-2">
          <label class="flex items-center space-x-2 cursor-pointer">
            <input type="checkbox" name="is_admin" value="1" class="w-4 h-4 rounded bg-[#040519] border-[#42425B] text-[#4A35CF]">
            <span class="text-xs font-semibold text-[#D5D5DB]">Administrator Privileges</span>
          </label>
          <p class="text-[11px] text-[#8282A4] ml-6 mt-0.5">Allows full access to panel settings, server creation, and node management.</p>
        </div>

        <div class="pt-4 border-t border-[#42425B]/40 flex items-center justify-end space-x-3">
          <a href="/admin/users" class="arix-btn arix-btn-secondary text-xs py-2 px-4">Cancel</a>
          <button type="submit" class="arix-btn arix-btn-primary text-xs py-2 px-5 font-semibold">
            Create User
          </button>
        </div>
      </form>
    </div>

  </main>
</div>

<%- include('../layouts/footer') %>
